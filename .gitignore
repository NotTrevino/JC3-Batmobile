# --- donors, extracted trees and build output --------------------------------
# Every one of these is either game content or a build artifact. None is ours to ship.
Original/
Working/*
!Working/Roadmap/
!Working/Translation/
!Working/Q/
!Working/RTTI/
Working/**/*.png
Working/**/*.jpg
Working/**/*.xml
Working/Roadmap/allq/src/
Builds/
Backups/
Logs/
Tests/
SerpenteR-EE/
Serpente-ArchiveScan/
SerpenteR-Test/
Playable_Batmobile_SF/
BmGame/
Startup/
game0-unpack/
JC3-Test/
Research/MemePack/
Research/Vehicle/
Research/Epe/
Research/blender/
# aaf/ is the game's own effect, camera, animation and skeleton tree, extracted per donor.
Research/*/aaf/
# ConvertProperty / ConvertAdf output of the game's entity and tuning files, and patched
# .bin slices: extracted content or game data, not notes.
Research/PartsForensics/
Research/SerpenteParts/
Research/SerpenteModules/
Research/SerpenteToc/
Research/Budgets/
Research/DaBaby/xml/
# ConvertAdf / ConvertProperty output of .vmodc and the entity property tree. These are
# the game's own tunable data in XML form -- effectively a data table -- so they are
# extracted content, not notes. Research/RBM/*.json and INVENTORY.* stay tracked: those
# are measurements and structural summaries we authored, and they cannot reconstruct
# anything.
Research/Physics/

# --- savegames and downloaded profiles ---------------------------------------
# A Nexus download of someone else's 100% save: save data, not ours to ship.
Just Cause 3 - 100 Percent*/

